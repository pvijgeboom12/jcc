---
import Logo from './Logo.astro';
import { t } from '../i18n/ui';
import { routes, type Lang, type Alternate } from '../i18n/routes';

interface Props {
  lang: Lang;
  alternate: Alternate;
  active?: 'congresses';
  showCta?: boolean;
  isHome?: boolean;
}
const { lang, alternate, active, showCta = true, isHome = false } = Astro.props;
const s = t(lang);
const home = routes.home[lang];
// Op de homepage springen de links naar secties; elders naar de homepage + sectie.
const anchor = (id: string) => (isHome ? `#${id}` : `${home}#${id}`);
const other: Lang = lang === 'nl' ? 'en' : 'nl';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={isHome ? '#top' : home} class="site-header__home" aria-label={s.homeAria}>
      <Logo height={40} withWordmark />
    </a>

    <nav aria-label={s.navLabel} class="site-nav">
      <a href={anchor('about')}>{s.nav.about}</a>
      <a href={anchor('what-we-do')}>{s.nav.whatWeDo}</a>
      <a href={routes.congresses[lang]} aria-current={active === 'congresses' ? 'page' : undefined}>{s.nav.congresses}</a>
      <a href={anchor('contact')}>{s.nav.contact}</a>
    </nav>

    <div class="site-header__actions">
      <div role="group" aria-label={s.langLabel} class="lang-switch">
        {
          (['nl', 'en'] as const).map((l) =>
            l === lang ? (
              <span aria-current="true" class="lang-switch__item is-active">
                {l.toUpperCase()}
              </span>
            ) : (
              <a href={alternate[other]} lang={other} hreflang={other} class="lang-switch__item">
                {l.toUpperCase()}
              </a>
            ),
          )
        }
      </div>
      {showCta && <a href={anchor('contact')} class="btn btn--primary btn--header site-header__cta">{s.cta}</a>}
    </div>
  </div>
</header>

<style>
  .site-header { background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
  .site-header__inner {
    padding-top: 18px; padding-bottom: 18px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;
  }
  .site-header__home { display: flex; align-items: center; text-decoration: none; }

  .site-nav { display: flex; flex-wrap: wrap; align-items: center; gap: 28px; font-size: 15px; font-weight: 400; }
  .site-nav a { color: var(--color-text); text-decoration: none; }
  .site-nav a:hover { color: var(--color-primary); }
  .site-nav a[aria-current='page'] { color: var(--color-primary); font-weight: 600; }

  .site-header__actions { display: flex; align-items: center; gap: 14px; }

  .lang-switch { display: flex; border: 1px solid var(--color-border-strong); border-radius: var(--radius-pill); padding: 3px; }
  .lang-switch__item {
    display: inline-flex; align-items: center; min-height: 36px; padding: 8px 14px;
    border-radius: var(--radius-pill); font-size: 13px; font-weight: 600;
    color: var(--color-text-secondary); text-decoration: none;
  }
  .lang-switch__item:hover { color: var(--color-primary); }
  .lang-switch__item.is-active { background: var(--color-primary); color: #fff; }

  /* Tablet en mobiel: menu onder het logo, horizontaal scrollbaar */
  @media (max-width: 1000px) {
    .site-header__inner { row-gap: 12px; }
    .site-nav {
      order: 3; width: 100%; flex-wrap: nowrap; overflow-x: auto; gap: 24px;
      padding-top: 12px; border-top: 1px solid var(--color-border);
      scrollbar-width: none;
    }
    .site-nav::-webkit-scrollbar { display: none; }
    .site-nav a { white-space: nowrap; padding: 6px 0; }
  }
  @media (max-width: 640px) {
    .site-header__cta { display: none; }
    .site-nav { gap: 12px; justify-content: space-between; font-size: 14px; }
  }
  @media (max-width: 370px) {
    .site-nav { font-size: 13px; }
  }
  @media (max-width: 380px) {
    .site-header__home :global(.logo__wordmark) { display: none; }
  }
</style>
