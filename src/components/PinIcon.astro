---
interface Props {
  color?: string;
}
const { color = '#8F2748' } = Astro.props;
---

<svg aria-hidden="true" viewBox="0 0 24 24" class="pin">
  <path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" fill="none" stroke={color} stroke-width="2.2"></path>
  <circle cx="12" cy="10" r="2.5" fill={color}></circle>
</svg>

<style>
  .pin { width: 14px; height: 14px; flex: 0 0 14px; margin-top: 3px; }
</style>
