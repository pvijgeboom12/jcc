---
import Logo from './Logo.astro';
import { t } from '../i18n/ui';
import { routes, type Lang } from '../i18n/routes';
import { site } from '../lib/site';

interface Props {
  lang: Lang;
  showLinkedIn?: boolean;
}
const { lang, showLinkedIn = true } = Astro.props;
const s = t(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Logo height={26} />
      <span>© {year} {s.siteName} · KvK {site.kvk}</span>
    </div>
    <div class="site-footer__links">
      <a href={routes.privacy[lang]}>{s.privacy}</a>
      {showLinkedIn && <a href={site.linkedin} rel="noopener">LinkedIn</a>}
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-bg); border-top: 1px solid var(--color-border); color: var(--color-text-secondary); }
  .site-footer__inner {
    padding-top: 32px; padding-bottom: 32px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px;
    font-size: 14px;
  }
  .site-footer__brand { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .site-footer__links { display: flex; flex-wrap: wrap; gap: 24px; }
  .site-footer__links a { color: var(--color-text); }
  .site-footer__links a:hover { color: var(--color-primary); }
</style>
