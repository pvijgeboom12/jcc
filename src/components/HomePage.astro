---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from './Eyebrow.astro';
import Swash from './Swash.astro';
import HeroSlideshow from './HeroSlideshow.astro';
import AgendaTiles from './AgendaTiles.astro';
import ContactForm from './ContactForm.astro';
import ArtPicture from './ArtPicture.astro';
import { home } from '../i18n/home';
import { alternateFor, type Lang } from '../i18n/routes';
import { site } from '../lib/site';
import { getUpcoming } from '../lib/congresses';
import { pic } from '../lib/images';


interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = home[lang];

// Bewijs uit eigen data: organisaties van congressen op de agenda (geen verzonnen klanten)
// Klantenlijst uit het CMS; valt terug op de organisaties van de komende congressen
const clients: string[] = (h.about as { clients?: string[] }).clients ?? [];
const orgs = clients.length ? clients : [...new Set((await getUpcoming(lang)).map((c) => c.data.organisation))];
const privacyHref = lang === 'nl' ? '/privacyverklaring/' : '/en/privacy/';
---

<BaseLayout lang={lang} title={h.metaTitle} description={h.metaDescription} alternate={alternateFor('home')} isHome>
  <HeroSlideshow lang={lang} />

  <AgendaTiles lang={lang} />

  <!-- OVER JCC -->
  <section id="about" class="bg-white">
    <div class="container section about">
      <div class="about__text" data-reveal>
        <Eyebrow class="eyebrow--long">{h.about.eyebrow}</Eyebrow>
        <h2 class="h2-xl">{h.about.heading}</h2>
        <div class="body-lg stack-20 about__body">
          {h.about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <p class="about__promise">{h.about.promise}</p>
      </div>
      <div class="about__media" data-reveal-stagger>
        <ArtPicture {...pic(h.about.images[0])} class="img about__img about__img--a" parallax={-30} sizes="(min-width: 1000px) 360px, 60vw" desktopWidths={[480, 720, 1000]} />
        <ArtPicture {...pic(h.about.images[1])} class="img about__img about__img--b" parallax={45} sizes="(min-width: 1000px) 300px, 45vw" desktopWidths={[400, 640, 900]} />
      </div>
    </div>
    {
      orgs.length > 0 && (
        <div class="container trust">
          <p class="trust__label">{h.about.trustLabel}</p>
          <ul class="trust__list">
            {orgs.map((o) => <li>{o}</li>)}
          </ul>
        </div>
      )
    }
  </section>

  <!-- WAT WE DOEN: vier stappen -->
  <section id="what-we-do" class="bg-surface">
    <div class="container section">
      <div class="services__head" data-reveal>
        <div>
          <Eyebrow>{h.services.eyebrow}</Eyebrow>
          <h2 class="h2-xl">{h.services.heading}</h2>
        </div>
        <p class="services__lead">{h.services.lead}</p>
      </div>
      <ol class="steps" data-reveal-stagger>
        {
          h.services.steps.map((s, i) => (
            <li class="step">
              <span class="step__num" aria-hidden="true">{i + 1}</span>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__core">{s.core}</p>
              <details class="step__more">
                <summary>{h.services.more}</summary>
                <ul>
                  {s.items.map(({ title, text }) => (
                    <li>
                      <span class="step__item">{title}</span>
                      <span class="muted">{text}</span>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- COMMUNITY -->
  <section id="community" class="bg-white">
    <div class="container section community">
      <div class="community__media" data-reveal-stagger>
        <ArtPicture {...pic(h.community.images[0])} class="img community__img" sizes="(min-width: 1000px) 560px, 100vw" desktopWidths={[640, 960, 1280]} mobileWidths={[400, 600, 900]} />
        <ArtPicture {...pic(h.community.images[1])} class="img community__img2" parallax={50} sizes="(min-width: 1000px) 220px, 40vw" desktopWidths={[300, 480, 700]} />
      </div>
      <div class="community__text" data-reveal>
        <Eyebrow>{h.community.eyebrow}</Eyebrow>
        <h2 class="community__heading">{h.community.heading} <em class="accent">{h.community.accent}</em></h2>
        <p class="body-lg community__lead">{h.community.lead}</p>
        <p class="community__closing">{h.community.closing}</p>
        <ul class="community__grid">
          {
            h.community.items.map(({ title, text }) => (
              <li>
                <span class="community__item">{title}</span>
                <span class="muted">{text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ANNICK: de persoon achter JCC -->
  <section id="annick" class="bg-white" aria-labelledby="annick-heading">
    <div class="container annick-wrap">
      <div class="annick">
        <div class="annick__media" data-reveal>
          <ArtPicture {...pic(h.annick.image)} class="img annick__img" parallax={-25} sizes="(min-width: 1000px) 440px, 90vw" desktopWidths={[400, 640, 880, 1100]} />
        </div>
        <div class="annick__text" data-reveal>
          <Eyebrow>{h.annick.eyebrow}</Eyebrow>
          <h2 id="annick-heading" class="h2-xl">{h.annick.heading} <em class="accent">{h.annick.accent}</em></h2>
          <div class="annick__body stack-20">
            {h.annick.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <p class="annick__closing">{h.annick.closing}</p>
          <p class="annick__sign">
            <span class="annick__signature" aria-hidden="true">{h.annick.signature}</span>
            <span class="annick__role">{h.annick.role}</span>
          </p>
          <a href="#contact" class="btn btn--primary annick__cta">{h.annick.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- MAATWERK-BAND -->
  <section class="band clip" aria-labelledby="band-heading">
    <svg class="arc" data-parallax="60" aria-hidden="true" viewBox="0 0 400 400" style="right:-90px;top:-150px;width:520px;height:520px">
      <path d="M 60 400 A 300 300 0 0 1 360 100" fill="none" stroke="#FFFFFF" stroke-opacity="0.14" stroke-width="34"></path>
    </svg>
    <div class="container relative band__inner" data-reveal-stagger>
      <h2 id="band-heading" class="band__heading">
        <span class="band__line">{h.band.headingBefore}</span>
        <span class="band__line">{h.band.headingWith} <Swash variant="white">{h.band.accent}</Swash></span>
      </h2>
      <p class="band__text"><strong class="band__intro">{h.band.intro}</strong> {h.band.text}</p>
    </div>
  </section>

  <!-- SOCIAAL PROGRAMMA -->
  <section class="bg-white" aria-labelledby="social-heading">
    <div class="container section social">
      <div class="social__text" data-reveal>
        <Eyebrow>{h.social.eyebrow}</Eyebrow>
        <h2 id="social-heading" class="h2-xl">{h.social.title} <em class="accent">{h.social.accent}</em></h2>
        <p class="body-lg social__lead">{h.social.text}</p>
        <ul class="social__points">
          {h.social.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
      <figure class="social__mosaic" data-reveal-stagger>
        <ArtPicture {...pic(h.social.images[0])} class="img social__main" sizes="(min-width: 1000px) 640px, 100vw" desktopWidths={[640, 960, 1280]} mobileWidths={[400, 600, 900]} />
        <ArtPicture {...pic(h.social.images[1])} class="img social__a" sizes="(min-width: 1000px) 320px, 50vw" desktopWidths={[400, 640, 900]} />
        <ArtPicture {...pic(h.social.images[2])} class="img social__b" parallax={35} sizes="(min-width: 1000px) 200px, 25vw" desktopWidths={[300, 480]} />
        <ArtPicture {...pic(h.social.images[3])} class="img social__c" parallax={-35} sizes="(min-width: 1000px) 200px, 25vw" desktopWidths={[300, 480]} />
        {h.social.images[4] && <ArtPicture {...pic(h.social.images[4])} class="img social__d" sizes="(min-width: 1000px) 260px, 100vw" desktopWidths={[300, 480, 700]} />}
        <figcaption class="social__caption">{h.social.caption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- VOOR WIE -->
  <section id="expertise" class="bg-surface">
    <div class="container section split">
      <div class="col col--narrow" data-reveal>
        <Eyebrow>{h.expertise.eyebrow}</Eyebrow>
        <h2 class="h2-xl">{h.expertise.heading} <em class="accent">{h.expertise.accent}</em></h2>
        <p class="body-lg expertise__lead">{h.expertise.lead}</p>
        <ul class="tags">
          {h.expertise.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      </div>
      <div class:list={['expertise__media', `expertise__media--${h.expertise.images.length}`]} data-reveal-stagger>
        {
          h.expertise.images.length >= 3 ? (
            <>
              <ArtPicture {...pic(h.expertise.images[0])} class="img expertise__wide" sizes="(min-width: 1000px) 620px, 100vw" desktopWidths={[560, 900, 1200]} />
              <ArtPicture {...pic(h.expertise.images[1])} class="img expertise__tall" sizes="(min-width: 1000px) 300px, 50vw" desktopWidths={[300, 600]} />
              <ArtPicture {...pic(h.expertise.images[2])} class="img expertise__tall" sizes="(min-width: 1000px) 300px, 50vw" desktopWidths={[300, 600]} />
            </>
          ) : (
            h.expertise.images.map((im, i) => (
              <ArtPicture {...pic(im)} class:list={['img', 'expertise__tall', { 'expertise__tall--offset': i === 1 }]} parallax={i === 1 ? 30 : undefined} sizes="(min-width: 1000px) 300px, 50vw" desktopWidths={[300, 600, 900]} />
            ))
          )
        }
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="bg-white">
    <div class="container section contact" data-reveal-stagger>
      <div class="contact__text">
        <h2 class="contact__heading">{h.contact.heading} <em class="accent">{h.contact.accent}</em></h2>
        <p class="lead contact__lead">{h.contact.lead}</p>
        <div class="contact__direct">
          <p class="contact__directlabel">{h.contact.direct}</p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
      <ContactForm lang={lang} privacyHref={privacyHref} />
    </div>
  </section>
</BaseLayout>

<style>
  .col { flex: 1 1 420px; min-width: 0; }
  .col--narrow { flex-basis: 380px; }
  .stack-20 { display: flex; flex-direction: column; gap: 20px; }
  ul, ol { list-style: none; margin: 0; padding: 0; }

  .h2-xl {
    font-weight: 600; letter-spacing: -0.022em; line-height: 1.08;
    font-size: clamp(30px, 3.6vw, 50px); text-wrap: balance;
  }

  /* Over */
  .about { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 72px; align-items: center; }
  .about__body { margin-top: 28px; max-width: 58ch; }
  .about__promise {
    margin-top: 32px; padding-left: 20px; border-left: 4px solid var(--color-primary);
    font-family: var(--font-heading); font-weight: 600; font-size: clamp(21px, 2vw, 26px); line-height: 1.3; color: var(--color-primary);
  }
  .about__media { position: relative; display: grid; grid-template-columns: 1fr 0.8fr; gap: 16px; align-items: end; }
  .about__media :global(.about__img--a) { aspect-ratio: 4 / 5; border-radius: 28px 28px 28px 120px; }
  .about__media :global(.about__img--b) { aspect-ratio: 4 / 5; border-radius: var(--radius-lg); margin-bottom: -48px; }
  .trust { padding-bottom: 80px; }
  .trust__label { font-size: 15px; font-weight: 600; color: var(--color-text-secondary); margin-bottom: 14px; }
  .trust__list { display: flex; flex-wrap: wrap; gap: 10px; }
  .trust__list li {
    border: 1.5px solid var(--color-border); border-radius: var(--radius-pill);
    padding: 10px 18px; font-size: 15px; font-weight: 600; color: var(--color-text);
  }

  /* Wat we doen */
  .services__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 48px; }
  .services__lead { max-width: 420px; font-size: 18px; line-height: 1.6; color: var(--color-text-lead); }
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; counter-reset: step; }
  .step {
    position: relative; background: #fff; border-radius: var(--radius-md); padding: 28px 26px 22px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .step::after {
    content: ''; position: absolute; top: 52px; right: -16px; width: 16px; height: 2px; background: var(--color-primary-tint);
  }
  .step:last-child::after { display: none; }
  .step__num {
    width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center;
    background: var(--color-primary); color: #fff; font-family: var(--font-heading); font-weight: 600; font-size: 22px;
  }
  .step__title { font-size: 22px; line-height: 1.2; margin-top: 8px; }
  .step__core { font-size: 17px; line-height: 1.55; color: var(--color-text-lead); flex: 1; }
  .step__more { border-top: 1px solid var(--color-border); padding-top: 12px; }
  .step__more summary {
    cursor: pointer; font-weight: 600; font-size: 15px; color: var(--color-primary);
    min-height: 44px; display: flex; align-items: center; gap: 8px; list-style: none;
  }
  .step__more summary::-webkit-details-marker { display: none; }
  .step__more summary::after { content: '+'; font-size: 20px; line-height: 1; }
  .step__more[open] summary::after { content: '–'; }
  .step__more ul { display: flex; flex-direction: column; gap: 12px; padding: 4px 0 6px; font-size: 15px; line-height: 1.5; }
  .step__item { display: block; font-weight: 600; color: var(--color-text); }

  /* Community */
  .community { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 72px; align-items: center; }
  .community__media { position: relative; padding-bottom: 56px; }
  .community__media :global(.community__img) { aspect-ratio: 4 / 5; border-radius: 160px 28px 28px 28px; }
  .community__media :global(.community__img2) {
    position: absolute; right: -24px; bottom: 0; width: 42%; aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg); border: 6px solid #fff;
  }
  .community__heading {
    font-weight: 600; letter-spacing: -0.025em; line-height: 1.02;
    font-size: clamp(36px, 4.6vw, 64px);
  }
  /* Zonder punten: elke zin op een eigen regel */
  .community__heading .accent { display: block; }
  /* Lang label (volledige bedrijfsnaam): op mobiel op één regel houden */
  @media (max-width: 480px) {
    :global(.eyebrow--long) { font-size: 10.5px; letter-spacing: 0.05em; white-space: nowrap; }
  }
  @media (max-width: 359px) {
    :global(.eyebrow--long) { white-space: normal; }
  }
  .community__heading .accent { display: block; }
  .community__lead { margin-top: 24px; max-width: 56ch; }
  .community__closing {
    margin-top: 20px; font-family: var(--font-heading); font-weight: 600;
    font-size: clamp(19px, 1.7vw, 22px); line-height: 1.35; color: var(--color-primary);
  }
  .community__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 28px; margin-top: 36px; font-size: 16px; line-height: 1.5; }
  .community__grid li { border-top: 2px solid var(--color-primary-tint); padding-top: 14px; }
  .community__item { display: block; font-weight: 600; color: var(--color-text); margin-bottom: 4px; font-size: 17px; }

  /* Band */
  .band { background: var(--color-primary); color: #fff; }
  .band__inner { padding-top: 96px; padding-bottom: 96px; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 56px; align-items: center; }
  .band__heading { color: #fff; font-weight: 600; letter-spacing: -0.03em; font-size: clamp(40px, 5.6vw, 80px); line-height: 1.02; }
  .band__line { display: block; }
  .band__text { font-size: 20px; line-height: 1.6; color: var(--color-primary-tint-2); max-width: 46ch; }
  .band__intro { display: block; margin-bottom: 10px; font-family: var(--font-heading); font-weight: 600; font-size: clamp(22px, 2vw, 26px); line-height: 1.3; color: #fff; }

  /* Annick */
  /* Volgt op de witte Community-sectie, gaat over in de bordeaux band */
  .annick-wrap { padding-top: 0; padding-bottom: var(--section-y); }
  .annick {
    display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr); gap: 64px; align-items: start;
    background: var(--color-surface); border-radius: var(--radius-xl); padding: 56px;
  }
  /* Portret blijft naast de lange tekst in beeld */
  /* Tekst links, foto rechts (op mobiel staat de foto boven) */
  .annick__media { position: sticky; top: 96px; order: 2; }
  .annick__media :global(.annick__img) { aspect-ratio: 4 / 5; border-radius: 28px 28px 120px 28px; }
  .annick__body { margin-top: 24px; font-size: 18px; line-height: 1.7; color: var(--color-text-body); max-width: 58ch; }
  .annick__closing { margin-top: 24px; font-size: 18px; font-weight: 600; color: var(--color-text); }
  .annick__sign { margin-top: 18px; display: flex; flex-direction: column; gap: 2px; }
  .annick__signature {
    font-family: var(--font-heading); font-style: italic; font-weight: 600;
    font-size: clamp(30px, 3vw, 40px); line-height: 1; color: var(--color-primary);
  }
  .annick__role { font-size: 14px; color: var(--color-text-secondary); }
  .annick__cta { margin-top: 28px; }

  /* Sociaal programma */
  .social { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 64px; align-items: center; }
  .social__lead { margin-top: 24px; }
  .social__points { margin-top: 28px; display: flex; flex-direction: column; gap: 12px; font-size: 17px; font-weight: 600; color: var(--color-text); }
  .social__points li { display: flex; align-items: center; gap: 12px; }
  .social__points li::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--color-primary); flex: 0 0 10px; }
  .social__mosaic {
    margin: 0; display: grid; grid-template-columns: 1.4fr 1fr 1fr; grid-template-rows: auto auto auto; gap: 12px;
  }
  .social__mosaic :global(.social__main) { grid-column: 1 / -1; aspect-ratio: 16 / 9; border-radius: var(--radius-xl); }
  /* Vijfde foto: naast de hoofdfoto, even hoog */
  .social__mosaic:has(:global(.social__d)) :global(.social__main) { grid-column: 1 / 3; }
  .social__mosaic :global(.social__d) { grid-column: 3; grid-row: 1; height: 100%; aspect-ratio: auto; border-radius: var(--radius-lg); }
  .social__mosaic :global(.social__a) { aspect-ratio: 4 / 3; border-radius: var(--radius-lg); height: 100%; }
  .social__mosaic :global(.social__b),
  .social__mosaic :global(.social__c) { aspect-ratio: 4 / 5; border-radius: var(--radius-lg); height: 100%; }
  .social__caption { grid-column: 1 / -1; font-size: 14px; color: var(--color-text-secondary); }

  /* Voor wie */
  .expertise__lead { margin-top: 24px; }
  .tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .tag { background: #fff; border-radius: var(--radius-pill); padding: 12px 18px; font-size: 15px; font-weight: 600; color: var(--color-text); }
  .expertise__media { flex: 1 1 480px; min-width: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .expertise__media :global(.expertise__wide) { grid-column: 1 / -1; aspect-ratio: 16 / 9; border-radius: var(--radius-lg); }
  .expertise__media :global(.expertise__tall) { aspect-ratio: 4 / 5; border-radius: var(--radius-lg); }
  .expertise__media :global(.expertise__tall--offset) { margin-top: 48px; }

  /* Contact */
  .contact { display: flex; flex-wrap: wrap; gap: 56px; }
  .contact__text { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .contact__heading { font-weight: 600; letter-spacing: -0.025em; font-size: clamp(34px, 4.2vw, 56px); line-height: 1.05; }
  .contact__lead { line-height: 1.65; }
  .contact__direct { display: flex; flex-direction: column; gap: 10px; font-size: 18px; }
  .contact__directlabel { font-size: 15px; font-weight: 600; color: var(--color-text-secondary); }
  .contact__direct a { color: var(--color-text); font-weight: 600; text-underline-offset: 4px; }
  .contact__direct a:hover { color: var(--color-primary); }

  @media (max-width: 999px) {
    .about, .community, .social, .band__inner, .annick { grid-template-columns: minmax(0, 1fr); gap: 48px; }
    .annick { padding: 40px; }
    .annick__media { position: static; max-width: 340px; order: 0; }
    .community__media { order: 2; max-width: 560px; }
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .step::after { display: none; }
  }
  @media (max-width: 640px) {
    .section { padding-top: 72px; padding-bottom: 72px; }
    .steps, .community__grid { grid-template-columns: minmax(0, 1fr); }
    .about__media { margin-bottom: 48px; }
    .about__media :global(.about__img--a) { border-radius: 24px 24px 24px 88px; }
    .community__media :global(.community__img) { border-radius: 96px 24px 24px 24px; }
    .community__media :global(.community__img2) { right: -8px; }
    .band__inner { padding-top: 72px; padding-bottom: 72px; }
    .annick-wrap { padding-top: 0; padding-bottom: 72px; padding-left: 16px; padding-right: 16px; }
    .annick { padding: 28px 20px 36px; gap: 32px; }
    .annick__media :global(.annick__img) { border-radius: 24px 24px 88px 24px; }
    .annick__body { font-size: 17px; }
    .social__mosaic { grid-template-columns: 1fr 1fr; }
    .social__mosaic :global(.social__main) { aspect-ratio: 4 / 5; }
    .social__mosaic :global(.social__a) { grid-column: 1 / -1; aspect-ratio: 16 / 9; }
    .social__mosaic :global(.social__d) { grid-column: 1 / -1; grid-row: auto; aspect-ratio: 16 / 9; }
  }
</style>
