---
/**
 * Agenda v2: grotere, beter leesbare congreskaarten.
 * Elke kaart is één link (hele kaart klikbaar) met datum, naam, locatie, status en actie.
 * Congressen zonder eigen pagina linken naar het congresoverzicht.
 */
import PinIcon from './PinIcon.astro';
import Eyebrow from './Eyebrow.astro';
import { t } from '../i18n/ui';
import { routes, congressPath, type Lang } from '../i18n/routes';
import { getUpcoming, isLinkable } from '../lib/congresses';
import { dayRange, monthYearShort } from '../lib/dates';

interface Props {
  lang: Lang;
  max?: number;
}
const { lang, max = 5 } = Astro.props;
const s = t(lang).agenda;
const upcoming = (await getUpcoming(lang)).slice(0, max);
---

{
  upcoming.length > 0 && (
    <section id="agenda" aria-labelledby="agenda-heading" class="agenda bg-white">
      <div class="container agenda__inner">
        <div class="agenda__head" data-reveal>
          <div>
            <Eyebrow>{s.eyebrow}</Eyebrow>
            <h2 id="agenda-heading" class="agenda__heading">{s.heading}</h2>
          </div>
          <a href={routes.congresses[lang]} class="agenda__all">{s.all}</a>
        </div>
        <ul class="agenda__grid" data-reveal-stagger>
          {upcoming.map((c, i) => {
            const d = c.data;
            const featured = i === 0;
            const linkable = isLinkable(c);
            const href = linkable ? congressPath(lang, d.slug) : routes.congresses[lang];
            const tile = d.tile ?? { title: d.title };
            const open = d.status === 'registratie-open';
            return (
              <li class:list={['tile', { 'tile--featured': featured }]}>
                <div class="tile__top">
                  {featured && <span class="tile__badge">{s.next}</span>}
                  <span class:list={['tile__status', { 'tile__status--open': open }]}>{open ? s.open : s.std}</span>
                </div>
                <p class="tile__date">
                  <span class="tile__day">{dayRange(d.startDate, d.endDate, lang)}</span>
                  <span class="tile__month">{monthYearShort(d.startDate, d.endDate, lang)}</span>
                </p>
                <h3 class="tile__title">
                  <a href={href} class="tile__link">
                    {tile.title}
                    {tile.subtitle && <span class="tile__subtitle">{tile.subtitle}</span>}
                  </a>
                </h3>
                <p class="tile__place">
                  <PinIcon color={featured ? '#F6D3DE' : '#8F2748'} />
                  {d.locationShort ?? d.location}
                </p>
                <p class="tile__cta" aria-hidden="true">{linkable ? `${s.view} →` : s.follows}</p>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .agenda__inner { padding-top: 72px; padding-bottom: 8px; }
  .agenda__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin: 0 0 28px; }
  .agenda__heading { font-weight: 600; letter-spacing: -0.02em; font-size: clamp(26px, 2.6vw, 36px); line-height: 1.1; }
  .agenda__all { font-size: 16px; font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; text-underline-offset: 4px; }
  .agenda__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; }

  .tile {
    position: relative; display: flex; flex-direction: column; gap: 6px;
    min-height: 280px; padding: 22px 22px 22px;
    border-radius: var(--radius-md); border: 1.5px solid var(--color-border);
    background: var(--color-surface); color: var(--color-text);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-tile-hover); border-color: var(--color-primary-tint); }
  .tile:focus-within { outline: 3px solid var(--color-primary); outline-offset: 3px; }
  .tile__link { color: inherit; text-decoration: none; }
  .tile__link:focus-visible { outline: none; }
  /* Hele kaart klikbaar via de link in de titel */
  .tile__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }

  .tile__top { display: flex; flex-wrap: wrap; gap: 6px; min-height: 28px; }
  .tile__badge, .tile__status {
    border-radius: var(--radius-pill); padding: 5px 12px;
    font-size: 13px; font-weight: 600; line-height: 1.3;
  }
  .tile__badge { background: #fff; color: var(--color-primary); }
  .tile__status { background: #fff; color: var(--color-text); border: 1px solid var(--color-border); }
  .tile__status--open { background: #e6f2ea; color: #1d5a33; border-color: #bcdcc6; }

  .tile__date { margin-top: 18px; display: flex; flex-direction: column; gap: 2px; }
  .tile__day { font-family: var(--font-heading); font-size: 44px; font-weight: 600; line-height: 1; letter-spacing: -0.03em; white-space: nowrap; color: var(--color-primary); }
  .tile__month { font-size: 16px; font-weight: 600; color: var(--color-text); }
  .tile__title { margin-top: auto; padding-top: 16px; font-size: 22px; font-weight: 600; line-height: 1.2; }
  .tile__subtitle { display: block; font-family: var(--font-body); font-size: 16px; font-weight: 400; color: var(--color-text-secondary); margin-top: 2px; }
  .tile__place { display: flex; gap: 6px; font-size: 15px; line-height: 1.4; color: var(--color-text-secondary); }
  .tile__cta { margin-top: 8px; font-size: 15px; font-weight: 600; color: var(--color-primary); }

  /* Uitgelicht: eerstvolgende congres */
  .tile--featured { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
  .tile--featured .tile__day, .tile--featured .tile__month, .tile--featured .tile__title, .tile--featured .tile__cta { color: #fff; }
  .tile--featured .tile__subtitle, .tile--featured .tile__place { color: var(--color-primary-tint-2); }
  .tile--featured:focus-within { outline-color: var(--color-text); }

  @media (max-width: 640px) {
    .agenda__inner { padding-top: 56px; }
    .tile { min-height: 0; }
    .tile__date { flex-direction: row; align-items: baseline; gap: 10px; margin-top: 12px; }
    .tile__day { font-size: 36px; }
  }
  @media (prefers-reduced-motion: reduce) { .tile:hover { transform: none; } }
</style>
