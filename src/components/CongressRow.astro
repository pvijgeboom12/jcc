---
import { t } from '../i18n/ui';
import { congressPath, type Lang } from '../i18n/routes';
import { isLinkable, type Congress } from '../lib/congresses';
import { dayRange, monthYearShort, fullDate } from '../lib/dates';

interface Props {
  lang: Lang;
  congress: Congress;
  past?: boolean;
}
const { lang, congress, past = false } = Astro.props;
const s = t(lang).overview;
const d = congress.data;
const href = congressPath(lang, d.slug);
const linkable = isLinkable(congress);
const open = d.status === 'registratie-open' && !past;
const registerHref = d.registrationUrl ?? `${href}#register`;
---

<article class:list={['row', { 'row--past': past }]}>
  <div class="row__date">
    <span class="row__day">{dayRange(d.startDate, d.endDate, lang)}</span>
    <span class="row__month">{monthYearShort(d.startDate, d.endDate, lang)}</span>
  </div>
  <div class="row__body">
    <h2 class="row__title">{linkable ? <a href={href}>{d.title}</a> : d.title}</h2>
    <p class="row__meta">{fullDate(d.startDate, d.endDate, lang)} · {d.location}</p>
  </div>
  {
    past ? null : open ? (
      <div class="row__actions">
        <a href={href} class="btn btn--outline btn--sm">{s.moreInfo}</a>
        <a href={registerHref} class="btn btn--primary btn--sm">{s.register}</a>
      </div>
    ) : (
      <div class="row__status">
        <span class="row__badge">{s.saveTheDate}</span>
        <span class="row__follow">{s.toFollow}</span>
      </div>
    )
  }
</article>

<style>
  .row {
    border: 1.5px solid var(--color-border); border-radius: var(--radius-lg); padding: 28px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 28px;
  }
  .row__date {
    flex: 0 0 120px; height: 112px; border-radius: var(--radius-sm); background: var(--color-surface);
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
  }
  .row__day {
    font-family: var(--font-heading); font-size: 30px; font-weight: 600; line-height: 1;
    letter-spacing: -0.02em; white-space: nowrap; color: var(--color-primary);
  }
  .row__month { font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .row__body { flex: 999 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .row__title { font-size: 28px; font-weight: 600; }
  .row__title a { color: inherit; text-decoration: none; }
  .row__title a:hover { color: var(--color-primary); }
  .row__meta { font-size: 16px; color: var(--color-text-secondary); }
  .row__actions { flex: 1 1 280px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-end; }
  .row__status { flex: 1 1 280px; display: flex; flex-direction: column; align-items: flex-end; gap: 6px; text-align: right; }
  .row__badge {
    font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-primary); background: var(--color-surface); border-radius: var(--radius-pill); padding: 9px 16px;
  }
  .row__follow { font-size: 14px; color: var(--color-text-secondary); }

  .row--past { opacity: 0.75; }
  .row--past .row__title { font-size: 22px; }

  @media (max-width: 640px) {
    .row { padding: 22px; gap: 20px; }
    .row__actions { justify-content: flex-start; }
    .row__status { align-items: flex-start; text-align: left; }
    .row__title { font-size: 24px; }
  }
</style>
