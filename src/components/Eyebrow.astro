---
/** Klein kopje boven secties, met het dubbele-C-icoon. */
interface Props {
  as?: 'p' | 'span';
  large?: boolean;
  class?: string;
}
const { as: Tag = 'p', large = false, class: cls = '' } = Astro.props;
---

<Tag class:list={['eyebrow', { 'eyebrow--lg': large }, cls]}>
  <svg aria-hidden="true" viewBox="0 0 24 24">
    <g fill="none" stroke-width="3.4">
      <path d="M20.5 6.1 A9.5 9.5 0 1 0 20.5 17.9" stroke="#8F2748"></path>
      <path d="M15.8 8.5 A4.5 4.5 0 1 0 15.8 15.5" stroke="#151515"></path>
    </g>
  </svg>
  <slot />
</Tag>
