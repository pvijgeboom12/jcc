---
/**
 * Bewegende logobalk met opdrachtgevers. Elk logo linkt naar de site van de
 * vereniging (nieuw tabblad). De lijst staat vier keer in de HTML zodat de
 * band naadloos doorloopt; de kopieën zijn verborgen voor schermlezers en
 * toetsenbord. Bij "beweging verminderen" staat de balk stil en loopt hij door
 * op de volgende regel. Hover of focus pauzeert de beweging.
 */
import { getImage } from 'astro:assets';
import { img } from '../lib/images';

export interface Partner {
  name: string;
  url: string;
  logo: string;
}
interface Props {
  partners: Partner[];
  label: string;
  newTab: string;
}
const { partners, label, newTab } = Astro.props;

const H = 64; // weergavehoogte in px
const items = await Promise.all(
  partners.map(async (p) => {
    const src = img(p.logo);
    const ratio = src.width / src.height;
    // Optisch gelijk: brede logo's iets hoger, smalle iets lager
    const h = Math.round(Math.min(1.3, Math.max(0.85, (ratio / 2.2) ** 0.35)) * H);
    const w = Math.round(ratio * h);
    const x1 = await getImage({ src, height: h, width: w, format: 'webp' });
    const x2 = await getImage({ src, height: h * 2, width: w * 2, format: 'webp' });
    return { ...p, w, h, src: x1.src, srcset: `${x1.src} 1x, ${x2.src} 2x` };
  }),
);
---

<div class="marquee" data-marquee>
  <p class="marquee__label">{label}</p>
  <div class="marquee__viewport">
    <div class="marquee__track">
      {[0, 1, 2, 3].map((copy) => (
        <ul class="marquee__list" aria-hidden={copy > 0 ? 'true' : undefined}>
          {items.map((p) => (
            <li>
              <a
                href={p.url}
                target="_blank"
                rel="noopener"
                class="marquee__link"
                tabindex={copy > 0 ? -1 : undefined}
                title={p.name}
              >
                <img src={p.src} srcset={p.srcset} width={p.w} height={p.h} style={`--h:${p.h}px`} alt={copy > 0 ? '' : `${p.name} (${newTab})`} loading="lazy" decoding="async" />
              </a>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee { padding-bottom: 80px; }
  .marquee__label { font-size: 15px; font-weight: 600; color: var(--color-text-secondary); margin-bottom: 20px; }
  .marquee__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee__track { display: flex; width: max-content; animation: marquee 48s linear infinite; }
  .marquee__viewport:hover .marquee__track,
  .marquee__viewport:focus-within .marquee__track { animation-play-state: paused; }
  .marquee__list { display: flex; align-items: center; gap: 72px; padding-right: 72px; list-style: none; margin: 0; }
  .marquee__link {
    display: flex; align-items: center; min-height: 88px; padding: 12px 4px; border-radius: 8px;
    transition: transform 0.25s;
  }
  .marquee__link:hover, .marquee__link:focus-visible { transform: scale(1.05); }
  .marquee__link:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; }
  .marquee__link img { display: block; height: var(--h); width: auto; max-width: none; }

  @keyframes marquee { to { transform: translateX(-50%); } }

  @media (max-width: 640px) {
    .marquee { padding-bottom: 64px; }
    .marquee__list { gap: 48px; padding-right: 48px; }
    .marquee__link img { height: calc(var(--h) * 0.8); }
    .marquee__track { animation-duration: 36s; }
  }

  /* Geen beweging gewenst: statisch raster, kopieën weg */
  @media (prefers-reduced-motion: reduce) {
    .marquee__viewport { -webkit-mask-image: none; mask-image: none; }
    .marquee__track { animation: none; width: auto; }
    .marquee__list { flex-wrap: wrap; gap: 24px 56px; padding-right: 0; }
    .marquee__list[aria-hidden='true'] { display: none; }
  }
</style>
