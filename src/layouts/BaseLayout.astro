---
// Self-hosted fonts volgens huisstijl (nov 2026): Poppins 600 voor koppen, Inter 400/600 voor tekst.
// Eigen @font-face met unicode-range in fonts.css (latin + latin-ext), geen Google Fonts.
import '../styles/fonts.css';
// De twee fonts boven de vouw: vooraf laden, zodat kop en tekst niet verspringen.
import interRegular from '../assets/fonts/inter-latin-400-normal.woff2?url';
import poppinsSemiBold from '../assets/fonts/poppins-latin-600-normal.woff2?url';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, organizationSchema } from '../lib/site';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultShare from '../assets/images/keynote-podium.jpg';
import type { Lang, Alternate } from '../i18n/routes';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternate: Alternate;
  active?: 'congresses';
  showCta?: boolean;
  isHome?: boolean;
  showLinkedIn?: boolean;
  noindex?: boolean;
  /** Deelafbeelding (og:image). Standaard: keynote-podium, 1200×630. */
  ogImage?: ImageMetadata;
  /** Extra structured data (JSON-LD), bijv. Event of BreadcrumbList. Organization staat er altijd in. */
  schema?: object | object[];
}

const {
  lang, title, description, alternate, active,
  showCta = true, isHome = false, showLinkedIn = true, noindex = false, ogImage, schema,
} = Astro.props;

const canonical = new URL(alternate[lang], site.url).href;
const fullTitle = title.includes('JCC') ? title : `${title} | JCC Congress Consultancy & Events`;
const share = await getImage({ src: ogImage ?? defaultShare, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 78 });
const shareUrl = new URL(share.src, site.url).href;
const jsonLd = [organizationSchema(lang), ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
const skip = lang === 'nl' ? 'Direct naar de inhoud' : 'Skip to content';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Scroll-animaties: verberg te animeren blokken vóór de eerste paint (niet bij "minder beweging").
         Vangnet: laadt het script niet binnen 3,5 s, dan wordt alles gewoon getoond. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('js-motion');
        setTimeout(function () { if (!window.__motionReady) d.classList.remove('js-motion'); }, 3500);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={interRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppinsSemiBold} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="nl" href={new URL(alternate.nl, site.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(alternate.en, site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternate.nl, site.url).href} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#8F2748" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JCC Congress Consultancy & Events" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'nl' ? 'nl_NL' : 'en_GB'} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })} />
    {
      /* Cloudflare Web Analytics: pas ná het laden van de pagina, zodat het niets van de eerste weergave afsnoept. */
      import.meta.env.PROD && site.cfAnalyticsToken && (
        <script is:inline define:vars={{ cfToken: site.cfAnalyticsToken }}>
          window.addEventListener('load', function () {
            var s = document.createElement('script');
            s.defer = true;
            s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
            s.setAttribute('data-cf-beacon', JSON.stringify({ token: cfToken }));
            document.head.appendChild(s);
          });
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{skip}</a>
    <Header lang={lang} alternate={alternate} active={active} showCta={showCta} isHome={isHome} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} showLinkedIn={showLinkedIn} />
    <script>
      // GSAP alleen laden op pagina's die animaties gebruiken
      if (document.querySelector('[data-reveal],[data-reveal-stagger],[data-parallax]')) {
        import('../scripts/motion');
      } else {
        (window as unknown as { __motionReady: boolean }).__motionReady = true;
      }
    </script>
  </body>
</html>
